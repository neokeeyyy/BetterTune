<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_search"
        android:shortcutId="search"
        android:shortcutShortLabel="@string/search">
        <intent
            android:action="com.arturo254.opentune.action.SEARCH"
            android:targetClass="com.arturo254.opentune.MainActivity"
            android:targetPackage="com.arturo254.opentune" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/shortcut_library"
        android:shortcutId="library"
        android:shortcutShortLabel="@string/filter_library">
        <intent
            android:action="com.arturo254.opentune.action.LIBRARY"
            android:targetClass="com.arturo254.opentune.MainActivity"
            android:targetPackage="com.arturo254.opentune" />
    </shortcut>
    <!-- Voice command: "Ok Google, play [song] on BetterTune" -->
    <shortcut
        android:shortcutId="play_audio"
        android:shortcutShortLabel="@string/play"
        android:shortcutLongLabel="@string/play"
        android:enabled="true"
        android:icon="@drawable/opentune">
        <capability-binding android:key="actions.intent.PLAY_AUDIO">
            <extra android:name="QUERY" android:value="" />
        </capability-binding>
        <intent
            android:action="android.media.action.MEDIA_PLAY_FROM_SEARCH"
            android:targetClass="com.arturo254.opentune.MainActivity"
            android:targetPackage="com.arturo254.opentune" />
    </shortcut>
</shortcuts>
